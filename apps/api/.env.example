# WebAuthn (Face ID / fingerprint / Windows Hello) relying party config.
# rpId must be the site's domain (no scheme/port); origin must be the exact
# scheme+host+port the browser sees. Defaults match local dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Signs JWT access tokens. If unset, the server generates an ephemeral
# secret at startup — fine for local dev, but every restart invalidates
# existing sessions. Set a real, stable value in any persistent deployment.
JWT_SECRET=
