# App ID/Secret from a Meta for Developers app (developers.facebook.com).
# Both required for POST /api/auth/facebook to work; the endpoint responds
# 503 "not configured" when either is unset rather than pretending to
# succeed.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Signs JWT access tokens. If unset, the server generates an ephemeral
# secret at startup — fine for local dev, but every restart invalidates
# existing sessions. Set a real, stable value in any persistent deployment.
JWT_SECRET=
