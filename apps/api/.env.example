# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> OAuth client
# ID -> Web application). Required for POST /api/auth/google to work; the
# endpoint responds 503 "not configured" when unset rather than pretending
# to succeed.
GOOGLE_CLIENT_ID=

# Signs JWT access tokens. If unset, the server generates an ephemeral
# secret at startup — fine for local dev, but every restart invalidates
# existing sessions. Set a real, stable value in any persistent deployment.
JWT_SECRET=
