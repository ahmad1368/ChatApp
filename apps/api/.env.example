# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> OAuth client
# ID -> Web application). Required for POST /api/auth/google to work; the
# endpoint responds 503 "not configured" when unset rather than pretending
# to succeed.
GOOGLE_CLIENT_ID=

# Signs JWT access tokens issued by phone/OTP signup and Google Sign-In. If
# unset, the server generates an ephemeral secret at startup — fine for
# local dev, but every restart invalidates existing sessions. Set a real,
# stable value in any persistent deployment.
JWT_SECRET=

# Optional: connect Socket.io's Redis adapter so broadcasts work correctly
# across multiple server instances behind a load balancer. Leave unset for a
# single-instance deployment (or local dev) — falls back to the in-memory
# adapter automatically.
REDIS_URL=

# Web Push (VAPID) keys — generate with `npx web-push generate-vapid-keys`.
# If unset, the server generates ephemeral keys at startup (dev only: existing
# push subscriptions won't survive a restart).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
