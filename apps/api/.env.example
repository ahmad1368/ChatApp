# Apple Services ID from the Apple Developer portal (Certificates, IDs &
# Profiles -> Identifiers -> Services IDs). Required for POST /api/auth/apple
# to work; the endpoint responds 503 "not configured" when unset rather than
# pretending to succeed.
APPLE_SERVICES_ID=

# Signs JWT access tokens. If unset, the server generates an ephemeral
# secret at startup — fine for local dev, but every restart invalidates
# existing sessions. Set a real, stable value in any persistent deployment.
JWT_SECRET=
