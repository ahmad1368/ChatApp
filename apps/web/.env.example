# API origin the browser talks to (Socket.io + REST).
NEXT_PUBLIC_API_URL=http://localhost:4000

# OAuth 2.0 Client ID from Google Cloud Console, used by Google Identity
# Services (accounts.google.com/gsi/client) to render the Sign in with
# Google button. Leave unset to show a disabled "not configured" button
# instead of a broken one.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: origin of a CDN fronting this app's static build output
# (JS/CSS/images). Leave unset to serve assets from the app itself.
NEXT_PUBLIC_CDN_URL=
