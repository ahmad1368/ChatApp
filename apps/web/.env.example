# API origin the browser talks to (Socket.io + REST).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Apple Services ID and the redirect URI registered for it in the Apple
# Developer portal. Both required to render a working Sign in with Apple
# button; leave unset to show a disabled "not configured" button instead.
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
